# Copie ce fichier en .env.local et remplis-le.
# Sans ces deux variables, l'app tourne sur la couche factice (mode démo).
# Clé « publishable » de Supabase : publique par conception, protégée par les règles RLS.
# Ne mets JAMAIS ici la clé secrète (service_role / secret).
EXPO_PUBLIC_SUPABASE_URL=https://<ton-projet>.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_...
